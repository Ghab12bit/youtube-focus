{
  "manifest_version": 3,
  "name": "Unpull: Grayscale & Blur YouTube Thumbnails, Focus Mode",
  "short_name": "Unpull",
  "version": "3.0.0",
  "description": "Grey out YouTube thumbnails, mute red alerts, blur search results and pause before you scroll. Also greys X, LinkedIn or any site.",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Unpull",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-unpull": {
      "suggested_key": { "default": "Alt+Shift+U", "mac": "Alt+Shift+U" },
      "description": "Turn Unpull on or off"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
